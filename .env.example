# ---------------------------------------------------------------------------
# UFMS Business Management Suite — environment reference
# Copy to .env for local development. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection. Use a managed provider (Neon/RDS/Cloud SQL) in production.
DATABASE_URL="postgresql://ufms:ufms_dev_local_only@127.0.0.1:5432/ufms_dev?schema=public"

# Comma-separated list of allowed browser origins for CORS.
CORS_ORIGINS="http://localhost:5173,http://localhost:4173"

# 32-byte base64 key used to encrypt integration credentials at rest.
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=""

# Session/JWT signing secret. Generate with: openssl rand -base64 48
AUTH_SECRET=""

# Comma-separated trusted root domains for tenant subdomain resolution.
TENANT_ROOT_DOMAINS="localhost,ufms.example.com"

# Email provider (adapter: console | smtp | ses | gmail)
EMAIL_PROVIDER="console"

# Object storage (Rule 4: never local filesystem). console = metadata-only dev.
STORAGE_PROVIDER="console"
STORAGE_BUCKET="ufms-dev"
STORAGE_MAX_BYTES="26214400"
# AI / marketing provider keys are stored encrypted per-tenant (ai_provider_configs.apiKeyEnc),
# never in env. See docs/commercial-saas.md.

# Free-tier / test deployment only. Never set true in production.
ALLOW_INSECURE_DEFAULTS="true"

# ---------------------------------------------------------------------------
# Production — Vercel + Railway + Neon (recommended for beginners)
# See docs/DEPLOY_VERCEL_RAILWAY_NEON_WINDOWS.md for step-by-step.
# ---------------------------------------------------------------------------
# DATABASE_URL="postgresql://neon_user:password@ep-xxx.neon.tech/neondb?sslmode=require"
# CORS_ORIGINS="https://your-frontend.vercel.app,https://www.yourdomain.com"
#
# Railway sets these automatically (just paste in Railway dashboard):
#   DATABASE_URL, AUTH_SECRET, CREDENTIAL_ENCRYPTION_KEY, NODE_ENV=production
#
# Vercel needs only one env var:
#   VITE_API_URL="https://your-backend.up.railway.app"
#
# Optional (when you add payments/email):
# STRIPE_WEBHOOK_SECRET="whsec_..."
# RAZORPAY_WEBHOOK_SECRET="..."
# REDIS_URL="redis://..."  # Railway -> Add Plugin -> Redis -> paste here
# EMAIL_PROVIDER="smtp"
# SMTP_HOST="smtp.gmail.com"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="app-password"

# ---------------------------------------------------------------------------
# Test databases — used by tests/database/tenant-isolation.test.ts
# ADMIN_DATABASE_URL connects as the migration owner (may bypass RLS).
# APP_DATABASE_URL connects as the least-privilege role (RLS ENFORCED) and is
# the credential the API actually uses in production.
# ---------------------------------------------------------------------------
ADMIN_DATABASE_URL="postgresql://ufms:ufms_dev_local_only@127.0.0.1:5432/ufms_dev"
APP_DATABASE_URL="postgresql://ufms_app:ufms_app_local_only@127.0.0.1:5432/ufms_dev"
