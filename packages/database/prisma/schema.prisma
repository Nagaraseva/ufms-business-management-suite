enum MarketingContactStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  INVALID
}

enum MarketingCampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  SENDING
  SENT
  CANCELLED
}

enum SocialPostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  FAILED
  CANCELLED
}

enum MomStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AiToolStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

enum CreativeStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

model MarketingContact {
